    "Uses Command+F1 and Command+F2. No changes to system key assignments.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Command+F1 and Command+F2. No changes to system key assignments."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Command+F1 和 Command+F2，不更改系统按键功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Command+F1 和 Command+F2，不更改系統按鍵功能。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise Commande+F1 et Commande+F2 sans modifier les fonctions des touches système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command+F1 と Command+F2 を使用します。システムのキー割り当ては変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command+F1 및 Command+F2를 사용합니다. 시스템 키 기능은 변경하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet Befehl+F1 und Befehl+F2. Die Systembelegungen der Tasten bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Comando+F1 y Comando+F2 sin cambiar las funciones de las teclas del sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует Command+F1 и Command+F2 без изменения системных назначений клавиш."
          }
        }
